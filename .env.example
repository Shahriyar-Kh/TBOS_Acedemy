# TechBuilt Open School — Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit .env or real secret keys to version control.

# Supabase Server-Side Persistence (Server-only credentials, never prefix with VITE_)
# Obtain from Supabase Project Settings -> API (Secret key / sb_secret_...):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Secondary Best-Effort Mirror: Google Apps Script Web App URL
# See GOOGLE_INTEGRATION.md for full setup
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
