# TechBuilt Open School — Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit real secret keys to version control.

# ==============================================================================
# 1. SERVER-ONLY (Keep private — Never prefix with VITE_ or bundle into client)
# ==============================================================================
# Supabase Project Settings -> API (Secret key / sb_secret_...):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Secondary Best-Effort Mirror: Google Apps Script Web App URL (Server-side only)
# See docs/INTEGRATIONS_SETUP.md for full setup
GOOGLE_SCRIPT_URL=

# Admissions Notifications & Acknowledgement Emails (Gmail SMTP via Nodemailer)
# See docs/INTEGRATIONS_SETUP.md for Google App Password instructions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
ADMISSIONS_NOTIFICATION_EMAIL=

# ==============================================================================
# 2. CLIENT AUTH (Public browser-safe keys)
# ==============================================================================
# Supabase Project Settings -> API (Publishable key / sb_publishable_... or legacy anon):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
